{
  "name": "mmd-workers",
  "private": true,
  "scripts": {
    "check": "node --check chat-worker/src/index.js && node --check scripts/smoke-chat-worker.js && node --check admin-worker/src/studio-real-worker.js && node --check admin-worker/src/mms-admin-runtime.js && node --check admin-worker/src/mms-admin-page.js",
    "smoke": "node scripts/smoke-chat-worker.js",
    "test": "npm run check && npm run smoke && npm run test:admin-login && npm run test:studio-real-worker && npm run test:telegram && npm run test:blackcard-confirm && npm run test:auth-liff-profile && npm run check:care-back-staging && npm run test:care-back-staging-fixtures && npm run test:member-pages-liff && npm run test:member-dashboard-liff && npm run test:member-dashboard-line && npm run test:mms",
    "test:admin-login": "node --test admin-worker/admin-login-hero.test.mjs admin-worker/admin-login-session.test.mjs admin-worker/admin-login-regression-guard.test.mjs",
    "test:studio-real-worker": "node --test admin-worker/studio-real-worker.test.mjs",
    "test:telegram": "node --test telegram-worker/test/*.test.mjs",
    "test:blackcard-confirm": "node --test webflow/blackcard/confirm/confirm-contract.test.mjs",
    "test:auth-liff-profile": "node --test auth-worker/test/member-status-resolver.test.mjs auth-worker/test/member-profile-resolver.test.mjs",
    "test:member-pages-liff": "node --experimental-global-webcrypto --test member-pages-worker/test/liff-gateway-airtable.test.mjs member-pages-worker/test/liff-member-shell.test.mjs member-pages-worker/test/liff-identity-foundation.test.mjs member-pages-worker/test/care-back-claim-store.test.mjs member-pages-worker/test/care-back-birthday-wish-store.test.mjs member-pages-worker/test/care-back-birthday-wish-coordinator.test.mjs member-pages-worker/test/care-back-i18n.test.mjs",
    "test:member-pages-runtime": "npm test --prefix member-pages-worker/test-runtime",
    "check:member-pages-wrangler": "npm run check --prefix member-pages-worker/test-runtime",
    "test:member-dashboard-liff": "node --test member-dashboard-chat-worker/test/liff-front-gate.test.mjs member-dashboard-chat-worker/test/rich-menu-publisher.test.mjs",
    "test:member-dashboard-line": "node --experimental-global-webcrypto --test member-dashboard-chat-worker/test/line-webhook.test.mjs member-dashboard-chat-worker/test/kenji-model-layer.test.mjs",
    "test:mms": "npm test --prefix mms-worker",
    "test:care-back-staging-fixtures": "node --test care-back-staging-fixtures-worker/test/*.test.mjs",
    "check:care-back-staging": "node scripts/check-care-back-staging-config.mjs",
    "smoke:care-back-staging": "node scripts/smoke-care-back-staging.mjs",
    "deploy:payments": "wrangler deploy --config workers/payments-worker/wrangler.toml",
    "deploy:admin": "npm run test:admin-login && npm run test:studio-real-worker && wrangler deploy --config admin-worker/wrangler.toml",
    "deploy:events": "wrangler deploy --config workers/events-worker/wrangler.toml",
    "deploy:telegram": "wrangler deploy --config telegram-worker/wrangler.toml",
    "deploy:sigil-booking": "wrangler deploy --config sigil-booking-worker/wrangler.toml",
    "deploy:sigil-board": "wrangler deploy --config workers/sigil-board-worker/wrangler.toml",
    "deploy:sigil-booking-proxy": "wrangler deploy --config workers/sigil-booking-proxy-worker/wrangler.toml",
    "deploy:mms": "npm run deploy --prefix mms-worker",
    "dev:payments": "wrangler dev --config workers/payments-worker/wrangler.toml",
    "dev:admin": "wrangler dev --config admin-worker/wrangler.toml",
    "dev:events": "wrangler dev --config workers/events-worker/wrangler.toml",
    "dev:telegram": "wrangler dev --config telegram-worker/wrangler.toml",
    "dev:sigil-booking": "wrangler dev --config sigil-booking-worker/wrangler.toml",
    "dev:sigil-board": "wrangler dev --config workers/sigil-board-worker/wrangler.toml",
    "dev:sigil-booking-proxy": "wrangler dev --config workers/sigil-booking-proxy-worker/wrangler.toml",
    "check:sigil-board": "node --check workers/sigil-board-worker/src/index.js",
    "check:sigil-board-webflow": "node --check webflow/mmd-gate.js && node --check webflow/sigil/board/kenji-board-v70-gate.js && node --check webflow/sigil/board/kenji-board-v70-runtime.js && node --check webflow/sigil/board/kenji-board-v70-smoke-test.js",
    "test:sigil-board-webflow": "node --test webflow/sigil/board/kenji-board-v70-gate.test.mjs",
    "check:sigil-booking-proxy": "node --check workers/sigil-booking-proxy-worker/src/index.js",
    "test:sigil-booking-proxy": "node --test workers/sigil-booking-proxy-worker/test/index.test.mjs",
    "check:kenji-member-memory": "node --check shared/kenji-member-memory-snapshot.mjs && node --check immigrate-worker/netlify/functions/kenji-member-memory-context.mjs",
    "test:kenji-line": "node --test shared/kenji-member-concierge-core.test.mjs",
    "test:kenji-member-memory": "node --test shared/kenji-member-memory-snapshot.test.mjs"
  }
}