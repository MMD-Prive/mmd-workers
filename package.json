{
  "name": "mmd-workers",
  "private": true,
  "scripts": {
    "check": "node --check chat-worker/src/index.js && node --check scripts/smoke-chat-worker.js && node --check admin-worker/src/studio-real-worker.js",
    "smoke": "node scripts/smoke-chat-worker.js",
    "test": "npm run check && npm run smoke && npm run test:admin-login && npm run test:studio-real-worker",
    "test:admin-login": "node --test admin-worker/admin-login-hero.test.mjs admin-worker/admin-login-session.test.mjs admin-worker/admin-login-regression-guard.test.mjs",
    "test:studio-real-worker": "node --test admin-worker/studio-real-worker.test.mjs",
    "deploy:mmd-redirect": "scripts/deploy-worker.sh mmd-redirect-worker",
    "deploy:payments": "scripts/deploy-worker.sh payments-worker",
    "deploy:member-pages": "scripts/deploy-worker.sh member-pages-worker",
    "deploy:member-api": "scripts/deploy-worker.sh member-api-worker",
    "deploy:sigil": "scripts/deploy-worker.sh sigil-worker",
    "deploy:admin": "scripts/deploy-worker.sh admin-worker",
    "deploy:events": "scripts/deploy-worker.sh events-worker",
    "deploy:telegram": "scripts/deploy-worker.sh telegram-worker",
    "deploy:chat": "scripts/deploy-worker.sh chat-worker",
    "deploy:sigil-booking": "scripts/deploy-worker.sh sigil-booking-worker",
    "deploy:sigil-board": "scripts/deploy-worker.sh sigil-board-worker",
    "deploy:sigil-booking-proxy": "scripts/deploy-worker.sh sigil-booking-proxy-worker",

    "dev:payments": "wrangler dev --config workers/payments-worker/wrangler.toml",
    "dev:admin": "wrangler dev --config admin-worker/wrangler.toml",
    "dev:events": "wrangler dev --config workers/events-worker/wrangler.toml",
    "dev:telegram": "wrangler dev --config telegram-worker/wrangler.toml",
    "dev:sigil-booking": "wrangler dev --config sigil-booking-worker/wrangler.toml",
    "dev:sigil-board": "wrangler dev --config workers/sigil-board-worker/wrangler.toml",
    "dev:sigil-booking-proxy": "wrangler dev --config workers/sigil-booking-proxy-worker/wrangler.toml",
    "check:sigil-board": "node --check workers/sigil-board-worker/src/index.js",
    "check:sigil-board-webflow": "node --check webflow/mmd-gate.js && node --check webflow/sigil/board/kenji-board-v70-gate.js && node --check webflow/sigil/board/kenji-board-v70-runtime.js && node --check webflow/sigil/board/kenji-board-v70-smoke-test.js",
    "test:sigil-board-webflow": "node --test webflow/sigil/board/kenji-board-v70-gate.test.mjs",
    "check:sigil-booking-proxy": "node --check workers/sigil-booking-proxy-worker/src/index.js",
    "test:sigil-booking-proxy": "node --test workers/sigil-booking-proxy-worker/test/index.test.mjs",
    "check:kenji-member-memory": "node --check shared/kenji-member-memory-snapshot.mjs && node --check immigrate-worker/netlify/functions/kenji-member-memory-context.mjs",
    "test:kenji-line": "node --test shared/kenji-member-concierge-core.test.mjs",
    "test:kenji-member-memory": "node --test shared/kenji-member-memory-snapshot.test.mjs"
  }
}
