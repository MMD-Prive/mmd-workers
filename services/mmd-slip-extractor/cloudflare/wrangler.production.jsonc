{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mmd-slip-extractor",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": {
    "MMD_RUNTIME_SCOPE": "production",
    "MMD_SLIP_EXTRACTOR_MAX_BYTES": "4194304"
  },
  "containers": [
    {
      "class_name": "SlipExtractorContainer",
      "image": "./Dockerfile",
      "image_build_context": "..",
      "max_instances": 2,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SLIP_EXTRACTOR",
        "class_name": "SlipExtractorContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "production-v1",
      "new_sqlite_classes": ["SlipExtractorContainer"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
