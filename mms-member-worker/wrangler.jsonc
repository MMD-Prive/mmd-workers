{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mms-member-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "durable_objects": {
    "bindings": [{ "name": "MMS_MEMBER_ACCOUNTS", "class_name": "MmsMemberAccount" }]
  },
  "migrations": [{ "tag": "v1-mms-members", "new_sqlite_classes": ["MmsMemberAccount"] }]
}
